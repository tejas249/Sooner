# Where a company or job board can reach you if your polling ever bothers them.
# It goes into the User-Agent header of every request, so use an address you read:
# an email address or a URL. The scripts and the worker refuse to run while this is empty.
HR_CONTACT=

# The database. For local development run `npm run db:dev` in a second terminal (it starts a real Postgres on this
# machine, no Docker needed), then `npm run db:migrate` and `npm run db:seed`. For a hosted database use its DIRECT
# connection string, not a pooled one: the migration runner holds a session-level lock.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/sooner

# Worker settings, all optional. The values shown are the defaults.
# POLLING_ENABLED=true        false keeps the worker running but stops all polling (the kill switch)
# ALL_BOARDS_FOLLOWED=false   true polls every board every five minutes; the priority boards in data/boards.json always are
# DB_POOL_MAX=10
# SHUTDOWN_GRACE_SEC=25       how long polls in flight get to finish when the worker is told to stop
# WORKER_ID=                  shows up in the logs; defaults to the host name and process id

# Alerts to yourself. Set one channel, and treat the address like a password. With none, alerts are logged only.
# ALERT_WEBHOOK_URL=          a Discord, Slack or other https webhook
# ALERT_TELEGRAM_BOT_TOKEN=   or a Telegram bot (with the chat's ID below)
# ALERT_TELEGRAM_CHAT_ID=
# MONITOR_INTERVAL_SEC=60     how often the worker looks at its own health (10 to 600)

# A heartbeat: an address at an outside monitor (Healthchecks.io, Better Stack, Uptime Kuma) that the worker pings while its
# loop is completing passes. When the pings stop, the monitor tells you the worker is down. A secret.
# HEARTBEAT_URL=
# HEARTBEAT_INTERVAL_SEC=60
