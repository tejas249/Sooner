{
  "name": "sooner",
  "version": "0.0.1",
  "private": true,
  "description": "Watches the public job-board feeds of a few hundred companies and tells you when a role opens, how long it has really been open, and whether the company fills its roles.",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "verify": "npm run typecheck && npm run lint && npm test",
    "feeds:check": "node --env-file-if-exists=.env scripts/check-feeds.ts",
    "detect": "node --env-file-if-exists=.env scripts/detect-ats.ts",
    "poll": "node --env-file-if-exists=.env scripts/poll-local.ts",
    "worker": "node --env-file-if-exists=.env src/worker/index.ts",
    "build:worker": "node scripts/build-worker.ts",
    "db:dev": "node tools/dev-db/serve.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/db-migrate.ts",
    "db:seed": "node --env-file-if-exists=.env scripts/db-seed.ts"
  },
  "dependencies": {
    "next": "^16.4.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.0",
    "fast-check": "^4.10.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
